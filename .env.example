# Environment Configuration Example
NODE_ENV=production
PORT=3000

# Database Configuration (Supabase PostgreSQL Connection Pooling recommended for Render)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/task_manager?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. production Netlify URL + local Vite dev)
CORS_ORIGINS="http://localhost:5173,https://your-app.netlify.app"
FRONTEND_URL="http://localhost:5173"